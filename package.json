{
  "name": "deck-companion",
  "version": "0.1.0",
  "type": "module",
  "description": "Game companion for Decky: on-demand screen translation (Japanese → Chinese) with vocabulary/grammar learning, and an AI chat with screenshots.",
  "scripts": {
    "build": "shx rm -rf dist && rollup -c",
    "watch": "rollup -c -w",
    "test": "node --test tests/i18n.test.mjs tests/translation-cache.test.mjs tests/ask-ai-state.test.mjs tests/overlay-layer.test.mjs",
    "build:deck": "rm -rf out && decky plugin build . -o ./out"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayanamimcy/deck-companion.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "translation",
    "language-learning",
    "steam-deck",
    "deck"
  ],
  "author": "ayanamimcy",
  "license": "GNU GPLv3",
  "bugs": {
    "url": "https://github.com/ayanamimcy/deck-companion/issues"
  },
  "homepage": "https://github.com/ayanamimcy/deck-companion",
  "devDependencies": {
    "@decky/api": "^1.1.3",
    "@decky/rollup": "^1.0.1",
    "@decky/ui": "^4.11.1",
    "@rollup/plugin-sucrase": "5.1.0",
    "@types/react": "16.14.0",
    "@types/react-dom": "^19.1.2",
    "@types/webpack": "^5.28.0",
    "rollup": "^4.24.0",
    "shx": "^0.3.4",
    "tslib": "^2.4.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "qrcode.react": "^4.2.0",
    "react-icons": "^4.4.0",
    "react-markdown": "8.0.7",
    "remark-gfm": "3.0.1"
  },
  "remote_binary": [
    {
      "name": "plugin-dependencies.tar.gz",
      "url": "https://github.com/ayanamimcy/deck-companion/releases/download/deps-v1/plugin-dependencies.tar.gz",
      "sha256hash": "TODO-set-after-building-deps"
    }
  ]
}
